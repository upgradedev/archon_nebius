# ── Nebius Identity ────────────────────────────────────────────────────────────
NEBIUS_IAM_TOKEN=your_iam_token_here
NEBIUS_PROJECT_ID=your_project_id_here
NEBIUS_REGION=eu-north1

# ── Nebius Object Storage (S3-compatible) ──────────────────────────────────────
NEBIUS_BUCKET_NAME=archon-docs
STORAGE_ENDPOINT_URL=https://storage.eu-north1.nebius.cloud
AWS_ACCESS_KEY_ID=your_storage_access_key
AWS_SECRET_ACCESS_KEY=your_storage_secret_key

# ── Nebius Managed PostgreSQL ──────────────────────────────────────────────────
POSTGRES_HOST=your_pg_host.mdb.eu-north1.nebius.cloud
POSTGRES_PORT=6432
POSTGRES_DB=archon
POSTGRES_USER=archon_user
POSTGRES_PASSWORD=your_pg_password_here
DATABASE_URL=postgresql://archon_user:your_pg_password_here@your_pg_host.mdb.eu-north1.nebius.cloud:6432/archon

# ── Nebius Inference API ───────────────────────────────────────────────────────
NEBIUS_INFERENCE_BASE_URL=https://api.studio.nebius.ai/v1
NEBIUS_INFERENCE_API_KEY=your_inference_api_key_here

# ── Vision model (used by the extraction job) ──────────────────────────────────
VISION_MODEL=Qwen/Qwen2-VL-72B-Instruct

# ── Analysis model (used by the analysis endpoint agent) ──────────────────────
ANALYSIS_MODEL=Qwen/Qwen2.5-72B-Instruct

# ── Container Registry ─────────────────────────────────────────────────────────
NEBIUS_REGISTRY=cr.nebius.com
NEBIUS_REGISTRY_PROJECT=your_project_id_here

# ── Deployed endpoint URL (set after running deploy-endpoint.sh) ───────────────
ANALYSIS_ENDPOINT_URL=https://your-endpoint.api.nebius.cloud

# ── Backend ────────────────────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000

# ── Job runner backend (nebius | aws | azure | gcp) ───────────────────────────
JOB_RUNNER_BACKEND=nebius

# ── Nebius job image (set after pushing extraction image) ─────────────────────
EXTRACTION_JOB_IMAGE=cr.nebius.com/YOUR_PROJECT/archon-extraction:latest
EXTRACTION_JOB_PLATFORM=gpu-l40s-a
EXTRACTION_JOB_PRESET=1gpu-8vcpu-32gb
