{env.CADDY_DOMAIN} {
	reverse_proxy localhost:8000

	# Self-signed cert from Caddy's internal CA — issued instantly, no ACME,
	# no Let's Encrypt rate limits. The browser never sees this cert: TLS is
	# terminated at Firebase Hosting (Google cert) and the Firebase BFF proxy
	# reaches this backend with verify=False. DuckDNS A-record updates still
	# happen in start.sh (independent of cert issuance).
	tls internal
}
