# Stage 1 — copy the official Caddy runtime binary.
# The Caddyfile uses `tls internal`; DuckDNS is updated by start.sh via HTTPS
# and does not require the caddy-dns/duckdns module. Avoiding xcaddy removes a
# fragile external Go module download from the deployment path.
FROM caddy:2 AS caddy-runtime

# Stage 2 — final image
FROM python:3.12-slim

WORKDIR /app

# Install Caddy binary from runtime stage
COPY --from=caddy-runtime /usr/bin/caddy /usr/bin/caddy

# Install curl (for DuckDNS IP update on startup)
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

RUN chmod +x start.sh

# Caddy listens on 443 (HTTPS); FastAPI on 8000 (internal only)
EXPOSE 443

CMD ["./start.sh"]
